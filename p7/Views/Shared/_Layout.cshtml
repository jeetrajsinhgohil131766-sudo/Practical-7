<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/Style.css" rel="stylesheet" />
</head>
<body style="margin: 0; font-family: Arial, sans-serif; display: flex; flex-direction: column; min-height: 100vh;">
    <!-- Header with Black Color -->
    <div class="header" style="background-color: black; color: white; padding: 15px 20px;">
        <h2 style="margin: 0 0 10px 0; color: white;">Student Feedback System</h2>
        <a href="@Url.Action("Index", "Home")" style="color: white; text-decoration: none; margin-right: 15px;">Home</a>
        <a href="@Url.Action("StudentFeedback", "Home")" style="color: white; text-decoration: none; margin-right: 15px;">Student Feedback</a>
        <a href="@Url.Action("Contact", "Home")" style="color: white; text-decoration: none;">Contact Us</a>
    </div>

    <!-- Main Content (flex: 1 pushes footer to the bottom of the screen) -->
    <div class="main-content" style="padding: 20px; flex: 1;">
        @RenderBody()
    </div>

    <!-- Footer with Black Color at the Bottom of the Screen -->
    <div class="footer" style="background-color: black; color: white; padding: 15px 20px; margin-top: auto;">
        <p style="margin: 0; color: white;">&copy; @DateTime.Now.Year - Student Feedback System</p>
    </div>
</body>
</html>
